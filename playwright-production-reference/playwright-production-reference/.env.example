# Copy this file to .env.local and replace values locally.
# Never commit .env.local, credentials, tokens, session files, or real client URLs.

TEST_BASE_URL=https://test.example.com
HTTP_AUTH_USERNAME=example-user
HTTP_AUTH_PASSWORD=example-password

ADMIN_USERNAME=admin@example.test
ADMIN_PASSWORD=replace-me
EDITOR_USERNAME=editor@example.test
EDITOR_PASSWORD=replace-me
END_USER_USERNAME=user@example.test
END_USER_PASSWORD=replace-me

EXPECTED_CMS_VERSION=1.2.3
EXPECTED_RUNTIME_VERSION=8.3
LOG_WINDOW_MINUTES=30
TEST_ENV=local
