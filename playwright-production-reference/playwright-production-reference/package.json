{
  "name": "playwright-production-reference",
  "version": "1.0.0",
  "private": true,
  "description": "Generic production-oriented Playwright E2E testing reference repository.",
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test -c tests/playwright/playwright.config.ts",
    "test:e2e:headed": "playwright test -c tests/playwright/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test -c tests/playwright/playwright.config.ts --ui",
    "test:e2e:debug": "PWDEBUG=1 playwright test -c tests/playwright/playwright.config.ts",
    "test:e2e:smoke": "playwright test -c tests/playwright/playwright.config.ts --grep @smoke",
    "test:e2e:report": "playwright show-report tests/reports/playwright/html",
    "lint:e2e": "eslint \"tests/**/*.ts\"",
    "lint:e2e:fix": "eslint \"tests/**/*.ts\" --fix",
    "typecheck:e2e": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^2.2.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
